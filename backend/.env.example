# 复制本文件为同目录下的 .env，按需填写后重启后端。
# Windows: copy .env.example .env

# 公网部署时填「用户浏览器打开的站点根 URL」（找回密码邮件里的链接）
# 本地开发示例：http://127.0.0.1:5173 ；Docker/Render 示例：https://你的域名.onrender.com
PUBLIC_APP_URL=http://127.0.0.1:5173

# --- Docker / 一体部署（宿主机一般不必设置；镜像内已由 Dockerfile 设置）---
# STATIC_ROOT=/app/static
# STRIP_API_PREFIX=1

# --- 数据库 ---
# 默认不写 DATABASE_URL → 使用 backend 目录下 users.db（SQLite）。
#
# 托管 Postgres（推荐线上长期保留账号）：把控制台「连接串」整行贴到 DATABASE_URL。
# 支持 postgres:// 与 postgresql://；代码会自动改用 psycopg3（postgresql+psycopg://）。
# Neon 示例：
# DATABASE_URL=postgresql://用户:密码@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Render Managed Postgres：创建 Postgres 实例后，把「Internal Database URL」或外部 URL 填到 Web Service 的 DATABASE_URL。
#
# SQLite + Render 持久盘（四个斜杠为绝对路径）：
# DATABASE_URL=sqlite:////var/data/users.db
# DATABASE_URL=

# --- 大模型（AI 辅导等接口需要；真实密钥只放在本机 .env，勿提交到 Git）---
# 任选其一：API_KEY 或 OPENAI_API_KEY
API_KEY=
# OPENAI_API_KEY=
BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# --- Render 等禁止出站 SMTP 时推荐：Resend HTTPS API（https://resend.com）---
# 下面两行取消注释并填写后，可在 backend 目录运行: python test_resend_local.py --to 你的邮箱
PASSWORD_RESET_RESEND_API_KEY=
PASSWORD_RESET_RESEND_FROM=onboarding@resend.dev
# 别名（与官网示例一致，任选其一组变量即可）：
# RESEND_API_KEY=
# RESEND_FROM=
# 默认 1：优先用官方 Python SDK（未安装或异常时可回退 urllib）；设为 0 则仅用 urllib
# PASSWORD_RESET_RESEND_USE_SDK=1

# --- 找回密码发信：Twilio SendGrid HTTPS API（Railway 等限制 SMTP 时推荐）---
# 在 SendGrid 完成 Single Sender Verification 后填写；也兼容官方变量名 SENDGRID_API_KEY。
PASSWORD_RESET_SENDGRID_API_KEY=
PASSWORD_RESET_SENDGRID_FROM=
# SENDGRID_API_KEY=
# SENDGRID_FROM=
# 欧盟区域子用户才需要设置为 eu；普通账号留空。
# PASSWORD_RESET_SENDGRID_DATA_RESIDENCY=

# --- 找回密码发信：Gmail API（HTTPS，不走 SMTP；Railway 推荐）---
# 先在 Google Cloud 启用 Gmail API 并创建 Desktop OAuth Client，然后运行:
#   python gmail_oauth_setup.py --client-id ... --client-secret ... --from-email your@gmail.com
PASSWORD_RESET_GMAIL_CLIENT_ID=
PASSWORD_RESET_GMAIL_CLIENT_SECRET=
PASSWORD_RESET_GMAIL_REFRESH_TOKEN=
PASSWORD_RESET_GMAIL_FROM=
# 别名：
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_FROM=

# --- 找回密码发信（直连 SMTP；云上可能 Errno 101，优先用上方 Resend）---
# QQ 邮箱示例：smtp.qq.com，端口 587，密码填「授权码」非 QQ 登录密码
PASSWORD_RESET_SMTP_HOST=
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_USER=
PASSWORD_RESET_SMTP_PASSWORD=
# 发件人，多数服务商要求与 SMTP_USER 为同一邮箱
PASSWORD_RESET_SMTP_FROM=

# 内网 25 端口等无需 TLS 时改为 0
# PASSWORD_RESET_SMTP_USE_TLS=1
# SMTP 连接超时秒数（默认 14，上限 18；托管网关过久无响应易返回 502）
# PASSWORD_RESET_SMTP_TIMEOUT_SEC=14
# 默认 1：优先使用 IPv4 连接 SMTP（云端容器无 IPv6 出口时可避免 Errno 101）
# PASSWORD_RESET_SMTP_PREFER_IPV4=1
