# 复制本文件为同目录下的 .env，按需填写后重启后端。
# Windows: copy .env.example .env

# 公网部署时填「用户浏览器打开的站点根 URL」（找回密码邮件里的链接）
# 本地开发示例：http://127.0.0.1:5173 ；Docker/Render 示例：https://你的域名.onrender.com
PUBLIC_APP_URL=http://127.0.0.1:5173

# --- Docker / 一体部署（宿主机一般不必设置；镜像内已由 Dockerfile 设置）---
# STATIC_ROOT=/app/static
# STRIP_API_PREFIX=1

# --- 数据库 ---
# 默认不写 DATABASE_URL → 使用 backend 目录下 users.db（SQLite）。
#
# 托管 Postgres（推荐线上长期保留账号）：把控制台「连接串」整行贴到 DATABASE_URL。
# 支持 postgres:// 与 postgresql://；代码会自动改用 psycopg3（postgresql+psycopg://）。
# Neon 示例：
# DATABASE_URL=postgresql://用户:密码@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Render Managed Postgres：创建 Postgres 实例后，把「Internal Database URL」或外部 URL 填到 Web Service 的 DATABASE_URL。
#
# SQLite + Render 持久盘（四个斜杠为绝对路径）：
# DATABASE_URL=sqlite:////var/data/users.db
# DATABASE_URL=

# --- 大模型（AI 辅导等接口需要；真实密钥只放在本机 .env，勿提交到 Git）---
# 任选其一：API_KEY 或 OPENAI_API_KEY
API_KEY=
# OPENAI_API_KEY=
BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# --- 找回密码发信：至少设置 HOST，否则不会连接 SMTP（仅控制台输出令牌）---
# QQ 邮箱示例：smtp.qq.com，端口 587，密码填「授权码」非 QQ 登录密码
PASSWORD_RESET_SMTP_HOST=
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_USER=
PASSWORD_RESET_SMTP_PASSWORD=
# 发件人，多数服务商要求与 SMTP_USER 为同一邮箱
PASSWORD_RESET_SMTP_FROM=

# 内网 25 端口等无需 TLS 时改为 0
# PASSWORD_RESET_SMTP_USE_TLS=1
