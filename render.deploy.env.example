# 用法：
# 1. 复制本文件为 render.deploy.env（勿提交 render.deploy.env）
# 2. 把下面占位符改成你的真实值
# 3. Render → Environment → Add from .env → 选择 render.deploy.env

STATIC_ROOT=/app/static
STRIP_API_PREFIX=1
PUBLIC_APP_URL=https://YOUR-SERVICE-NAME.onrender.com
API_KEY=

# ----- 可选：若你用 OPENAI_API_KEY 这个名字而不是 API_KEY，保留下一行并删掉上面的 API_KEY -----
# OPENAI_API_KEY=

# ----- 可选：非默认模型或网关 -----
# BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# ----- 数据库（线上强烈建议 Postgres，账号与会话可长期保留）-----
# Neon / Supabase / Render Postgres：粘贴连接串，例如：
# DATABASE_URL=postgresql://用户:密码@ep-xxx.aws.neon.tech/neondb?sslmode=require
#
# 仍用 SQLite + 持久盘时：
# DATABASE_URL=sqlite:////var/data/users.db
# DATABASE_URL=

# ----- Render 禁止 SMTP 出站时推荐：Resend（HTTPS）-----
# PASSWORD_RESET_RESEND_API_KEY=re_xxxx
# RESEND_API_KEY=re_xxxx
# PASSWORD_RESET_RESEND_FROM=Mentor <onboarding@resend.dev>
# RESEND_FROM=onboarding@resend.dev
# 默认 1：优先官方 Python SDK；0 则仅用 urllib
# PASSWORD_RESET_RESEND_USE_SDK=1

# ----- 推荐：Twilio SendGrid（HTTPS，不依赖 SMTP 出站端口）-----
# PASSWORD_RESET_SENDGRID_API_KEY=SG.xxxx
# PASSWORD_RESET_SENDGRID_FROM=bokuririri@foxmail.com
# SENDGRID_API_KEY=SG.xxxx
# SENDGRID_FROM=bokuririri@foxmail.com
# PASSWORD_RESET_SENDGRID_DATA_RESIDENCY=

# ----- 可选：找回密码发邮件（QQ 邮箱 SMTP；云上常被屏蔽）-----
# PASSWORD_RESET_SMTP_HOST=smtp.qq.com
# PASSWORD_RESET_SMTP_PORT=587
# PASSWORD_RESET_SMTP_USER=
# PASSWORD_RESET_SMTP_PASSWORD=
# PASSWORD_RESET_SMTP_FROM=
# 云端常见仅有 IPv4：默认优先 IPv4 连 SMTP，减轻 Errno 101（无需可注释掉）
# PASSWORD_RESET_SMTP_PREFER_IPV4=1
